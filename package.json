{
  "name": "electron-setup-wordpress-core",
  "author": "WordPress.org",
  "version": "1.0.1",
  "private": true,
  "license": "GPL-2.0-or-later",
  "description": "Desktop app that sets up a WordPress core development environment with no prerequisites, applies the work already on a Trac ticket, and submits a contribution back",
  "homepage": "https://wordpress.github.io/contributor-toolkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WordPress/contributor-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/WordPress/contributor-toolkit/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:once && concurrently -k \"npm:build:watch\" \"electron .\"",
    "build:watch": "esbuild src/renderer/index.jsx --bundle --outdir=src/renderer --loader:.css=css --platform=browser --format=iife --jsx=automatic --log-level=info --watch",
    "build:once": "esbuild src/renderer/index.jsx --bundle --outdir=src/renderer --loader:.css=css --platform=browser --format=iife --jsx=automatic --log-level=info",
    "postinstall": "electron-builder install-app-deps && npm run build:once",
    "dist:win": "npm run build:once && electron-builder --win --publish never",
    "dist:win:arm64": "npm run build:once && electron-builder --win --arm64 --publish never",
    "dist": "npm run build:once && electron-builder --publish never",
    "pack:dir": "electron-builder --dir --publish never",
    "test": "node --test",
    "test:electron": "node scripts/run-tests-electron.cjs",
    "test:e2e": "playwright test --project=journeys",
    "test:e2e:packaged": "playwright test --project=packaged",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "shots": "npm run build:once && node scripts/screenshots/capture.cjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview"
  },
  "build": {
    "appId": "org.wordpress.contributor.toolkit",
    "productName": "WordPress Contributor Toolkit",
    "artifactName": "wordpress-contributor-toolkit-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "!src/renderer/index.jsx",
      "local-playground-web/**/*",
      "!node_modules/dugite/git/libexec/git-core/*.dll",
      "!node_modules/dugite/git/libexec/git-core/*.dylib",
      "!node_modules/dugite/git/libexec/git-core/*.json",
      "!node_modules/dugite/git/libexec/git-core/git-credential-manager",
      "!node_modules/dugite/git/libexec/git-core/git-lfs",
      "!node_modules/dugite/git/libexec/git-core/createdump",
      "!node_modules/dugite/git/libexec/git-core/{cs,de,es,fr,it,ja,ko,pl,pt-BR,ru,tr,zh-Hans,zh-Hant}{,/**/*}",
      "!node_modules/dugite/git/{mingw64,clangarm64}/libexec/git-core/git-credential-manager*",
      "!node_modules/dugite/git/{mingw64,clangarm64}/libexec/git-core/git-lfs.exe",
      "!node_modules/dugite/git/{mingw64,clangarm64}/bin/git-lfs.exe",
      "!node_modules/dugite/git/{mingw64,clangarm64}/bin/git-credential-manager*",
      "!node_modules/dugite/git/{mingw64,clangarm64}/bin/git-credential-helper-selector.exe",
      "!node_modules/dugite/git/{mingw64,clangarm64}/bin/{Avalonia,Microsoft,System,Atlassian}*.dll",
      "!node_modules/dugite/git/{mingw64,clangarm64}/bin/{gcmcore,GitHub,GitLab,MicroCom.Runtime,msalruntime,av_libglesv2}.dll",
      "!node_modules/dugite/git/{mingw64,clangarm64}/bin/*{SkiaSharp,HarfBuzzSharp}*.dll",
      "!node_modules/dugite/git/{mingw64,clangarm64}/doc{,/**/*}",
      "!node_modules/dugite/git/{mingw64,clangarm64}/share/doc{,/**/*}",
      "!node_modules/fs-ext-extra-prebuilt/build/*.vcxproj*",
      "!node_modules/fs-ext-extra-prebuilt/build/Release/fs_ext.{exp,iobj,ipdb,lib}",
      "!node_modules/fs-ext-extra-prebuilt/build/Release/obj{,/**/*}"
    ],
    "asarUnpack": [
      "node_modules/dugite/git/**"
    ],
    "icon": "build/icon.png",
    "linux": {
      "maintainer": "WordPress.org",
      "target": [
        "AppImage",
        "snap",
        "deb"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "sign": "./scripts/azure-sign.cjs",
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "provisioningProfile": ".codesigning/org.wordpress.contributor.toolkit.provisionprofile",
      "notarize": true
    }
  },
  "dependencies": {
    "@wp-playground/cli": "^3.1.47",
    "diff": "^5.2.0",
    "dugite": "3.2.3",
    "electron-log": "^5.4.4",
    "electron-store": "^10.0.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "mailparser": "^3.7.1",
    "npm": "^10.8.2",
    "smtp-server": "^3.14.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@playwright/test": "^1.62.1",
    "@wordpress/components": "^28.2.0",
    "@wordpress/eslint-plugin": "^25.7.0",
    "@wordpress/icons": "^10.7.0",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.23.0",
    "eslint": "^9.39.5",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xterm": "^5.3.0"
  },
  "allowScripts": {
    "dugite@3.2.3": true,
    "electron-winstaller@5.4.0": true,
    "electron@43.2.0": true,
    "esbuild@0.23.1": true,
    "fs-ext-extra-prebuilt@2.2.7": true
  }
}
