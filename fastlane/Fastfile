# frozen_string_literal: true

require 'tmpdir'
require 'shellwords'

UI.user_error!('Please run fastlane via `bundle exec`') unless FastlaneCore::Helper.bundler?

############
# Constants
############
APPLE_BUNDLE_IDENTIFIER = 'org.wordpress.contributor.toolkit'
APP_BASENAME = 'WordPress Contributor Toolkit'
APPLE_TEAM_ID = 'PZYM8XX95Q'

PROJECT_ROOT_FOLDER = File.dirname(File.expand_path(__dir__))
BUILDS_FOLDER = File.join(PROJECT_ROOT_FOLDER, 'dist')

############
# Lanes
############

before_all do |_lane|
  setup_ci # Fixes Keychain access on CI

  # macOS 26 CI images don't ship the "Developer ID Certification Authority" G2
  # intermediate, and `match` installs only the leaf. Without the intermediate in
  # a search-list keychain, `security` can't build the chain and evaluates the
  # identity as CSSMERR_TP_NOT_TRUSTED — electron-builder then silently skips
  # signing. Install it into the temp keychain `setup_ci` just created.
  if FastlaneCore::Helper.is_ci?
    cert_path = File.join(Dir.tmpdir, 'DeveloperIDG2CA.cer')
    sh('curl', '-fsSL', 'https://www.apple.com/certificateauthority/DeveloperIDG2CA.cer', '-o', cert_path)
    import_certificate(certificate_path: cert_path, keychain_name: 'fastlane_tmp_keychain')
  end
end

desc 'Download the development signing certificates to this machine'
lane :setup_code_signing do |readonly: true|
  check_env_vars!
  app_store_connect_api_key(
    key_id: ENV.fetch('APPLE_API_KEY_ID'),
    issuer_id: ENV.fetch('APPLE_API_ISSUER'),
    key_filepath: ENV.fetch('APPLE_API_KEY')
  )

  sync_code_signing(
    platform: 'macos',
    app_identifier: APPLE_BUNDLE_IDENTIFIER,
    team_id: APPLE_TEAM_ID,
    type: 'developer_id',
    storage_mode: 's3',
    s3_bucket: 'a8c-fastlane-match',
    readonly: readonly
  )

  # Copy the installed profile to the path set in `package.json`'s `build.mac.provisioningProfile` key, so that `electron-builder` can find it
  installed_profile_path = ENV["sigh_#{APPLE_BUNDLE_IDENTIFIER}_developer_id_macos_profile-path"]
  destination_path = File.join(PROJECT_ROOT_FOLDER, '.codesigning', "#{APPLE_BUNDLE_IDENTIFIER}.provisionprofile")
  FileUtils.mkdir_p(File.dirname(destination_path))
  FileUtils.cp(installed_profile_path, destination_path)
end

# Verify that the built `.app` bundles are signed with our Developer ID and
# accepted by Gatekeeper, so an unsigned or wrongly-signed build fails the CI
# job instead of shipping.
lane :verify_code_signing do
  expected_authority = "Developer ID Application: Automattic, Inc. (#{APPLE_TEAM_ID})"

  apps = Dir[File.join(BUILDS_FOLDER, 'mac*', '*.app')]
  UI.user_error!("No `.app` bundle found under #{BUILDS_FOLDER}/mac*/ to verify") if apps.empty?

  apps.each do |app|
    UI.message("Verifying code signature: #{app}")

    # The signature is intact and satisfies its own designated requirement.
    sh('codesign', '--verify', '--deep', '--strict', '--verbose=2', app)

    # Gatekeeper accepts it — passes only when Developer ID signed *and* notarized+stapled.
    sh('spctl', '--assess', '--type', 'execute', '--verbose=2', app)

    # Signed by our identity specifically, not merely some other valid certificate.
    details = `codesign --display --verbose=2 #{app.shellescape} 2>&1`
    UI.user_error!("#{app} is not signed by '#{expected_authority}':\n#{details}") unless details.include?("Authority=#{expected_authority}")
  end

  UI.success("Verified code signing for #{apps.length} app bundle(s)")
end

############
# Helpers
############

def check_env_vars!
  required_vars = %w[APPLE_API_KEY_ID APPLE_API_ISSUER APPLE_API_KEY]
  required_vars.each do |var|
    UI.user_error!("The environment variable `#{var}` is required but not set") unless ENV.key?(var)
  end
end
