# Misc
.DS_Store
smtpd
CLAUDE.local.md

# Node
node_modules
dist

# VitePress output and cache (docs site). Built by CI and `npm run docs:build`.
docs/.vitepress/dist
docs/.vitepress/cache

# esbuild output. Built by `postinstall`, `npm start` and `npm run dist`, so it never has to
# be committed — and cannot drift from src/renderer/index.jsx the way it used to (#120).
src/renderer/index.js
src/renderer/index.css

# Playwright output. Traces, screenshots and the HTML report are written per run and
# uploaded as CI artifacts on failure; none of it is worth committing.
playwright-report
test-results

# Files with potential secrets
.env
.codesigning/

# Fastlane
fastlane/README.md
fastlane/report.xml

# Bundler, and the npm package cache the artifact builds keep between runs. Neither is app content,
# and neither reaches the packaged app: `build.files` in package.json names what ships, and `vendor`
# is not on it (#399).
vendor/bundle
vendor/npm
